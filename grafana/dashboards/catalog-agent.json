      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(llm_cost_usd_total{service_name=\"catalog-agent\",service_version!~\"verify-.*\"}[24h]))",
          "legendFormat": "__auto",
          "refId": "A"
