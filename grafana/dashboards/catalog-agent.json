        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_agent_request_cost_sum{service_name=\"catalog-agent\",service_version!~\"verify-.*\"}[1h])) / sum(rate(llm_agent_request_cost_count{service_name=\"catalog-agent\",service_version!~\"verify-.*\"}[1h]))",
          "legendFormat": "__auto",
          "refId": "A"
